            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 7c53b5b7b299f4afd81252dbee24ecb4, type: 2}
            Text: "Tapi Ryan sudah mengantisipasi kemungkinan dirinya dibungkam.
