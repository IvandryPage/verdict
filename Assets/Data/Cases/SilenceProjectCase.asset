    - rid: 2436170619896463492
      type: {class: DialogueNodeData, ns: Verdict.Data.Narrative, asm: Assembly-CSharp}
      data:
        nodeId: a25c4e9a4b384e48a6f15721fa5b12e0
        position: {x: 32457, y: 925}
        entries:
        - Type: 0
          Line:
            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 7c53b5b7b299f4afd81252dbee24ecb4, type: 2}
            Text: Dimas tidak tahu siapa pembunuhnya. Tapi ia baru saja membuka pintu
              menuju sesuatu yang jauh lebih besar dari sekadar satu kasus pembunuhan.
            Emotion: 2
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
        - Type: 0
          Line:
            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 09de275642787432ba3d7d86c79f9d91, type: 2}
            Text: (berbisik) Jer... ini beneran soal Ryan doang, atau ada hal lain
              yang lebih besar?
            Emotion: 6
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
        - Type: 0
          Line:
            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 7c53b5b7b299f4afd81252dbee24ecb4, type: 2}
            Text: (pelan) Aku juga baru mulai kepikiran hal yang sama.
            Emotion: 3
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
        nextNodeId: feded6e200644e9eb980037a29dea701
