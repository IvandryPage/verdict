        position: {x: 34522, y: 961}
        entries:
        - Type: 0
          Line:
            SpeakerType: 1
            Speaker: {fileID: 0}
            Text: Arga datang membawa dua kotak makanan, duduk diam di sudut ruangan
              sambil memperhatikan Jeremy bekerja.
            Emotion: 0
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
        - Type: 0
          Line:
            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 09de275642787432ba3d7d86c79f9d91, type: 2}
            Text: Aku nggak bisa bantu banyak. Tapi setidaknya biar kamu makan malam
              ini.
            Emotion: 7
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
