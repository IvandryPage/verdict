        nextNodeId: 4154107d40f044818d33c74f71e97579
    - rid: 2436170619896463489
      type: {class: DialogueNodeData, ns: Verdict.Data.Narrative, asm: Assembly-CSharp}
      data:
        nodeId: 4154107d40f044818d33c74f71e97579
