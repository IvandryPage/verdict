        nodeId: a8508db207a94b7a9c379cfbeb024fa3
        position: {x: 12834, y: 295}
        entries:
        - Type: 0
          Line:
            SpeakerType: 1
            Speaker: {fileID: 0}
            Text: Layar proyektor menampilkan deretan metadata dokumen, waktu dibuat,
              waktu diubah, nama pengguna yang mengaksesnya terakhir kali.
            Emotion: 0
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
        - Type: 0
          Line:
            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 2fcb5362c23634d1aa0de45037bed35c, type: 2}
            Text: Dokumen ini terakhir disunting dua hari sebelum korban meninggal,
              dari akun yang terdaftar atas nama korban sendiri.
            Emotion: 0
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
        - Type: 0
          Line:
            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 7c53b5b7b299f4afd81252dbee24ecb4, type: 2}
            Text: (Jadi ini bukan dokumen lama yang kebetulan tersimpan. Ryan sedang
              aktif mengerjakannya sampai hari-hari terakhir.)
            Emotion: 3
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
        nextNodeId: eba2dbd89cf84514b7817f7765f3e3ee
