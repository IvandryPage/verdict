    - rid: 2436170619896463535
      type: {class: DialogueNodeData, ns: Verdict.Data.Narrative, asm: Assembly-CSharp}
      data:
        nodeId: 1bd5d290aae84c968da6a29ed7cc90e4
        position: {x: 56454, y: 719}
        entries:
        - Type: 0
          Line:
            SpeakerType: 1
            Speaker: {fileID: 0}
            Text: Tiba-tiba, seseorang dari bangku pengunjung mengangkat tangan dan
              berdiri.
            Emotion: 0
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
        - Type: 0
          Line:
            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 8996332f3801948ccae6bf7c96dce3e8, type: 2}
            Text: Yang Mulia... saya punya sesuatu yang harus saya sampaikan.
            Emotion: 6
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
        - Type: 0
          Line:
            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 3a35bb1be8e1f408cafde3a2ee30b85a, type: 2}
            Text: Pengadilan mengizinkan Anda maju sebagai saksi. Silakan perkenalkan
              diri Anda.
            Emotion: 2
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
        - Type: 1
          Line:
            SpeakerType: 0
            Speaker: {fileID: 0}
            Text: 
            Emotion: 0
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 4
            Parameter: cam_witness_stand
            Value: 0.8
        - Type: 0
          Line:
            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 8996332f3801948ccae6bf7c96dce3e8, type: 2}
            Text: Nama saya Melati Wulandari. Saya asisten pribadi Pak Adrian selama
              dua tahun terakhir.
            Emotion: 6
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
        nextNodeId: 5e8a7c55f78948eeb077f5e9b763040b
