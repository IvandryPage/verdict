            Type: 0
            Parameter: 
            Value: 0
        - Type: 0
          Line:
            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 69434817a93924e6b9f55baa5b75264b, type: 2}
            Text: Penuntut umum memanggil AKP Yudi Setiawan, penyidik utama kasus
              ini, ke mimbar saksi. Kesaksian yang akan disampaikan akan menegaskan
              bahwa apa yang kita hadapi bukan hanya pembunuhan biasa, melainkan
              juga permasalahan yang menyentuh Pasal 2 dan 3 UU Tipikor.
            Emotion: 0
            WaitMode: 0
            AutoAdvanceDelay: 1
