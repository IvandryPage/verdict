      data:
        nodeId: 41d9104e69074ec7932f0cbcf3d62f71
        position: {x: 14261, y: 356}
        entries:
        - Type: 0
          Line:
            SpeakerType: 1
            Speaker: {fileID: 0}
            Text: Nadia menggulir ke bagian lain dari laporannya, nadanya sedikit
              berubah, lebih hati-hati.
            Emotion: 0
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
        - Type: 0
          Line:
            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 2fcb5362c23634d1aa0de45037bed35c, type: 2}
            Text: Ada satu hal lagi. Kami menemukan log perintah penghapusan jarak
              jauh, dikirim dari luar jaringan kantor.
            Emotion: 2
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
        - Type: 0
          Line:
            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 69434817a93924e6b9f55baa5b75264b, type: 2}
            Text: Keberatan, Yang Mulia. Saksi belum menyampaikan sumber perintah
              tersebut secara pasti.
            Emotion: 0
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
        - Type: 0
          Line:
            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 3a35bb1be8e1f408cafde3a2ee30b85a, type: 2}
            Text: Dicatat. Lanjutkan, saksi.
            Emotion: 0
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
        nextNodeId: 019386654495452d8b623d83033d2379
