            Text: 
            Emotion: 0
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 4
            Parameter: cam_witness_stand
            Value: 0
        - Type: 0
          Line:
            SpeakerType: 1
            Speaker: {fileID: 0}
            Text: Yudi berjalan mantap ke kursi saksi, map cokelat tebal terselip
              di bawah lengannya. Ia sudah membawakan kesaksian seperti ini puluhan
              kali.
            Emotion: 0
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
        - Type: 0
          Line:
            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 3a35bb1be8e1f408cafde3a2ee30b85a, type: 2}
            Text: Saksi, silakan menyampaikan keterangan Anda sejujur-jujurnya.
            Emotion: 2
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
