        entries:
        - Type: 0
          Line:
            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 69434817a93924e6b9f55baa5b75264b, type: 2}
            Text: Yang Mulia, pembela sepertinya kehabisan argumen. Saya mohon dakwaan
