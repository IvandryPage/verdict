        entries:
        - Type: 0
          Line:
            SpeakerType: 1
            Speaker: {fileID: 0}
            Text: Rekaman CCTV tambahan, riwayat GPS, dan log panggilan tersusun
              rapi di papan gabus, sebuah garis waktu baru mulai terbentuk.
            Emotion: 0
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
        - Type: 0
          Line:
            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 7c53b5b7b299f4afd81252dbee24ecb4, type: 2}
            Text: (Ada celah waktu yang tidak pernah ditelusuri penyidik. Celah yang
              cukup lebar untuk seseorang lain masuk.)
            Emotion: 0
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
        - Type: 0
          Line:
            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 7c53b5b7b299f4afd81252dbee24ecb4, type: 2}
            Text: Kalau garis waktu ini benar, kita cuma butuh sedikit lagi.
            Emotion: 0
            WaitMode: 0
            AutoAdvanceDelay: 1
