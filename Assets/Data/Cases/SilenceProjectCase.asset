            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 7c53b5b7b299f4afd81252dbee24ecb4, type: 2}
            Text: (Untuk pertama kalinya sejak persidangan dimulai, Adrian benar-benar
              kehilangan kendali.)
            Emotion: 2
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
