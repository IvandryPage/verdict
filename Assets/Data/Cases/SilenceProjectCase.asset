            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 3a35bb1be8e1f408cafde3a2ee30b85a, type: 2}
            Text: Pembunuhan Ryan Pratama ternyata hanyalah bagian kecil dari sebuah
              konspirasi yang jauh lebih besar.
            Emotion: 2
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
