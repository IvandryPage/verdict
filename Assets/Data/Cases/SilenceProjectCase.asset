    - rid: 2436170619896463443
      type: {class: DialogueNodeData, ns: Verdict.Data.Narrative, asm: Assembly-CSharp}
      data:
        nodeId: 4ec2ead05ef14fa898ef194dc577fc1c
        position: {x: 7152, y: 419}
        entries:
        - Type: 1
          Line:
            SpeakerType: 0
            Speaker: {fileID: 0}
