        statementId: 05cf76c70d8f4b4c90ac71269e3fd5a7
        nextNodeId: cb73dda933d942e2b2c1397b3062720f
    - rid: 2436170619896463541
      type: {class: DialogueNodeData, ns: Verdict.Data.Narrative, asm: Assembly-CSharp}
      data:
        nodeId: cb73dda933d942e2b2c1397b3062720f
        position: {x: 58803, y: 979}
        entries:
        - Type: 0
          Line:
            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 323acac8dfbd849f3b6a33fcf0dbc13d, type: 2}
            Text: "I-itu tidak benar! Dia hanya asisten biasa, dia tidak tahu apa-apa
