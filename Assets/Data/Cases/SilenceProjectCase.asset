            Type: 0
            Parameter: 
            Value: 0
        - Type: 0
          Line:
            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 4a70e9b81c26641538e12311bd81d732, type: 2}
            Text: S-saya siap memberikan keterangan, Yang Mulia.
