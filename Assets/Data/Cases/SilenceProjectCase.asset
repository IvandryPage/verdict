          Line:
            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 3a35bb1be8e1f408cafde3a2ee30b85a, type: 2}
            Text: Jaksa, silakan panggil saksi pertama.
            Emotion: 0
            WaitMode: 0
            AutoAdvanceDelay: 1
