    - rid: 2436170619896463538
      type: {class: DialogueNodeData, ns: Verdict.Data.Narrative, asm: Assembly-CSharp}
      data:
        nodeId: 8b4a17abdd5c4c95a7339869af979ba3
        position: {x: 57277, y: 979}
        entries:
        - Type: 0
          Line:
            SpeakerType: 1
            Speaker: {fileID: 0}
            Text: Tangan Melati gemetar memegang map kecil yang ia bawa. Sesekali
              ia melirik ke arah Adrian, lalu buru-buru menunduk lagi.
            Emotion: 0
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
        - Type: 0
          Line:
            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 8996332f3801948ccae6bf7c96dce3e8, type: 2}
            Text: Saya... saya takut. Tapi saya nggak bisa terus diam setelah tahu
              apa yang sebenarnya terjadi malam itu.
            Emotion: 7
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
        nextNodeId: be634a920e1b4875999e5d04cbf1cfe0
    - rid: 2436170619896463540
      type: {class: StatementNodeData, ns: Verdict.Data.Narrative, asm: Assembly-CSharp}
