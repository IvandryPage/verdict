            Type: 0
            Parameter: 
            Value: 0
        - Type: 0
          Line:
            SpeakerType: 1
            Speaker: {fileID: 0}
            Text: Jeremy meminta properti perangkat itu diperiksa lebih lanjut, alih-alih
