            Text: Pembela, apakah Anda siap melanjutkan dengan pemeriksaan saksi
              pertama?
            Emotion: 0
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
        - Type: 0
          Line:
            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 7c53b5b7b299f4afd81252dbee24ecb4, type: 2}
            Text: Kami siap, Yang Mulia.
            Emotion: 2
            WaitMode: 1
            AutoAdvanceDelay: 0.6
