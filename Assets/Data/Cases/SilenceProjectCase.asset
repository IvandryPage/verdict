            Type: 0
            Parameter: 
            Value: 0
        - Type: 0
          Line:
            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 09de275642787432ba3d7d86c79f9d91, type: 2}
            Text: (menatap papan gabus, suaranya pelan) Itu... itu foto rapat kickoff
              proyek. Aku ada di situ juga.
            Emotion: 0
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
        - Type: 0
          Line:
            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 7c53b5b7b299f4afd81252dbee24ecb4, type: 2}
            Text: Kamu ada di situ karena kerjaan. Tapi satu orang lain di foto itu
              ada di HAMPIR semua bukti yang kita kumpulkan.
            Emotion: 0
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
