          Line:
            SpeakerType: 1
            Speaker: {fileID: 0}
            Text: Seluruh data berhasil dipulihkan.
            Emotion: 0
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
        - Type: 1
          Line:
            SpeakerType: 0
            Speaker: {fileID: 0}
            Text: 
            Emotion: 0
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 4
            Parameter: cam_courtroom_wide
