    - rid: 2436170619896463494
      type: {class: DialogueNodeData, ns: Verdict.Data.Narrative, asm: Assembly-CSharp}
      data:
        nodeId: 1b4be7e45bee409284f44923413bd7bc
        position: {x: 33765, y: 946}
        entries:
        - Type: 1
          Line:
            SpeakerType: 0
            Speaker: {fileID: 0}
            Text: 
            Emotion: 0
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: bgm_investigation
            Value: 0.5
        - Type: 0
          Line:
            SpeakerType: 1
            Speaker: {fileID: 0}
            Text: 'Pemain mulai memahami: pembunuhan bukanlah tujuan utama. Tujuan
              sebenarnya adalah menghentikan Ryan sebelum bukti korupsi tersebar.'
            Emotion: 0
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
        - Type: 0
          Line:
            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 7c53b5b7b299f4afd81252dbee24ecb4, type: 2}
            Text: '(Persidangan ini sekarang punya dua lapis: membuktikan Arga tak
              bersalah, dan membuktikan Ryan dibunuh karena yang ia ketahui.)'
            Emotion: 2
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
        - Type: 0
          Line:
            SpeakerType: 0
            Speaker: {fileID: 11400000, guid: 7c53b5b7b299f4afd81252dbee24ecb4, type: 2}
            Text: (Kita mulai dari titik yang paling dekat, malam kejadian itu sendiri.)
            Emotion: 0
            WaitMode: 0
            AutoAdvanceDelay: 1
          Event:
            Type: 0
            Parameter: 
            Value: 0
        nextNodeId: 008efd4ee6e643e686b529205ec59daa
    - rid: 2436170619896463495
